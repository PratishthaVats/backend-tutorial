{
  "info": {
    "_postman_id": "c1a2b3d4-e5f6-4789-abcd-ef0123456789",
    "name": "Backend Development Assignment — Express & MongoDB",
    "description": "Postman Collection for University Backend Tutorial Assignment. Covers Health Check, Authentication (Register, Login), and full CRUD operations on Posts.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
