              "    pm.expect(jsonData.data.name).to.eql(\"Updated Student Research Paper\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
