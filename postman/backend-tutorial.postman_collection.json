  "item": [
    {
      "name": "1. Health Check",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Server reports healthy status\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    pm.expect(jsonData.message).to.be.a(\"string\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/health",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "health"]
        },
        "description": "Checks if the server is up and responsive."
      },
      "response": []
    },
    {
      "name": "2. Register User",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test(\"User registered without exposing password\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    pm.expect(jsonData.data).to.have.property(\"_id\");",
              "    pm.expect(jsonData.data).to.have.property(\"email\");",
              "    pm.expect(jsonData.data).to.not.have.property(\"password\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"teststudent\",\n  \"email\": \"teststudent@example.com\",\n  \"password\": \"Secur3Pass!\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/users/register",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "users", "register"]
        },
        "description": "Registers a new user and returns user info without password."
      },
      "response": []
    },
    {
      "name": "3. Login User",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Login successful\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    pm.expect(jsonData.data.email).to.eql(\"teststudent@example.com\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"teststudent@example.com\",\n  \"password\": \"Secur3Pass!\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/users/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "users", "login"]
        },
        "description": "Authenticates a registered user with email and password."
      },
      "response": []
    },
    {
      "name": "4. Create Post",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test(\"Post created and ID saved to collection variable\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    pm.expect(jsonData.data).to.have.property(\"_id\");",
              "    pm.collectionVariables.set(\"postId\", jsonData.data._id);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Student Research Paper\",\n  \"description\": \"Exploring RESTful architectures and Node.js microservices\",\n  \"age\": 21\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/posts/create",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "posts", "create"]
        },
        "description": "Creates a new post document and saves its _id to the postId variable."
      },
      "response": []
    },
    {
